# Copy to .env on the server (chmod 600 .env). Never commit the real file.

# The server's address: its static IP with dashes, plus .sslip.io (no https://).
SITE_ADDRESS=13-233-10-20.sslip.io

# Database password: long and random, e.g. from: openssl rand -base64 24
POSTGRES_PASSWORD=

# Your POS owner account (the /platform page). Use a new, strong password.
PLATFORM_EMAIL=
PLATFORM_PASSWORD=

# Optional: an admin for the built-in restaurant 1 ("My Restaurant"). Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: error alerts to Telegram.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Nightly backups to S3 (made in V5). Leave the bucket empty to keep backups on the server only.
# The key should only be allowed to write to this bucket.
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1

# Menu scan: API key from https://aistudio.google.com (use a paid-tier project for real restaurants).
GEMINI_API_KEY=
# Optional, default gemini-3.6-flash
GEMINI_MODEL=
# Optional: tried when the main model is busy or retired (default gemini-3.5-flash)
GEMINI_FALLBACK_MODEL=

# Error tracking (Sentry free plan). Empty = off.
SENTRY_DSN=
# Traces and metrics (Grafana Cloud > OpenTelemetry). Empty = off.
# Headers look like: Authorization=Basic%20<base64 of instanceId:token>
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
# Log shipping (Grafana Cloud > Loki). Set all three to start the log agent; empty = off.
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_LOKI_TOKEN=
