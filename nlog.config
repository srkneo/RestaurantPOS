<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <!-- async: a request never waits for a log line to be written (under load, waiting on the console or disk slowed requests). -->
  <targets async="true">
    <!-- At most 5 old files of 10 MB each, so logs never fill the server's disk. -->
    <target xsi:type="File" name="logfile" fileName="logs/logfile.txt"
            archiveAboveSize="10485760" maxArchiveFiles="5"
            layout="${longdate} ${uppercase:${level}} [${scopeproperty:RequestId:whenEmpty=-}] ${message} ${exception:format=tostring}" />
    <!-- OB1: one JSON object per line (time in UTC, request ID, restaurant, user, event fields) for the monitoring agent. -->
    <target xsi:type="File" name="jsonfile" fileName="logs/log.json"
            archiveAboveSize="10485760" maxArchiveFiles="5">
      <layout xsi:type="JsonLayout" includeEventProperties="true" maxRecursionLimit="1">
        <attribute name="time" layout="${date:universalTime=true:format=o}" />
        <attribute name="level" layout="${level:upperCase=true}" />
        <attribute name="logger" layout="${logger}" />
        <attribute name="message" layout="${message}" />
        <attribute name="requestId" layout="${scopeproperty:RequestId}" />
        <attribute name="tenant" layout="${scopeproperty:Tenant}" />
        <attribute name="userId" layout="${scopeproperty:UserId}" />
        <attribute name="exception" layout="${exception:format=tostring}" />
      </layout>
    </target>
    <target xsi:type="Console" name="console"
            layout="${longdate} ${uppercase:${level}} [${scopeproperty:RequestId:whenEmpty=-}] ${message} ${exception:format=tostring}" />
  </targets>

  <rules>
    <!-- Framework chatter (every SQL command, every request start and end) only from Warning up; our own code from Info. -->
    <logger name="Microsoft.EntityFrameworkCore.*" maxlevel="Info" final="true" />
    <logger name="Microsoft.AspNetCore.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="logfile,jsonfile,console" />
  </rules>
</nlog>
