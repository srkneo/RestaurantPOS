<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Targets.Seq"/>
  </extensions>

  <targets>
    <!-- At most 5 old files of 10 MB each, so logs never fill the server's disk. -->
    <target xsi:type="File" name="logfile" fileName="logs/logfile.txt"
            archiveAboveSize="10485760" maxArchiveFiles="5"
            layout="${longdate} ${uppercase:${level}} ${message} ${exception:format=tostring}" />
    <target xsi:type="Console" name="console"
            layout="${longdate} ${uppercase:${level}} ${message} ${exception:format=tostring}" />
    <target xsi:type="Seq" name="seq" serverUrl="http://localhost:5341" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="logfile,console,seq" />
  </rules>
</nlog>
